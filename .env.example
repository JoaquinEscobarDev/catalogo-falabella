# Copiá este archivo como .env y completá los valores

# PostgreSQL — obligatorio, ya no hay fallback a JSON local.
# En el VPS (Docker Compose) la arma docker-compose.yml sola.
# En la PC (scripts/refresh-local.js, scripts/watch-refresh.js) apunta al
# túnel SSH hacia el VPS — ver DEPLOY.md.
DATABASE_URL=postgresql://catalogo:contraseña@127.0.0.1:5433/catalogo_falabella

# Proxy residencial opcional, solo si el server (VPS) también queda bloqueado
# por Cloudflare al hacer scraping on-demand. Dejalo vacío si no aplica.
PROXY_URL=

# Solo para correr scripts/migrate-from-neon.js una vez (ver DEPLOY.md paso 5)
# OLD_DATABASE_URL=postgresql://usuario:contraseña@ep-xxx.neon.tech/neondb?sslmode=require
# NEW_DATABASE_URL=postgresql://catalogo:contraseña@postgres:5432/catalogo_falabella
