# Copiá este archivo como .env y completá los valores

# ── En el VPS (lo lee docker-compose.yml) ──────────────────────────────────

# Contraseña del Postgres del compose. DATABASE_URL la arma el compose sola.
POSTGRES_PASSWORD=elegí-una-contraseña-larga

# Refresh automático de precios, stock y cupones dentro del servidor.
# Horas del día (0-23, hora de Chile) en que corre el refresh completo.
# Varias separadas por coma, ej: 7,15
REFRESH_HOURS=7
# 0 = apagarlo (solo si vas a refrescar desde otra máquina con scripts/*.js)
AUTO_REFRESH=1

# Proxy residencial. Solo hace falta si en la portada de la app aparece el
# aviso "Falabella bloqueó al servidor": las IP de datacenter a veces quedan
# bloqueadas por Cloudflare. Formato: http://usuario:clave@host:puerto
PROXY_URL=

# ── Fuera de Docker (npm start en Railway, o scripts/ desde una PC) ─────────

# DATABASE_URL=postgresql://catalogo:contraseña@127.0.0.1:5433/catalogo_falabella

# Solo para correr scripts/migrate-from-neon.js una vez (ver DEPLOY.md paso 5)
# OLD_DATABASE_URL=postgresql://usuario:contraseña@ep-xxx.neon.tech/neondb?sslmode=require
# NEW_DATABASE_URL=postgresql://catalogo:contraseña@postgres:5432/catalogo_falabella
